# ============ JUPITER (execution + price fallback) ============
# Base: https://api.jup.ag  (/price/v3 + /swap/v2). FREE tier = 1 RPS.
# Get a key (free) at https://developers.jup.ag/portal
JUPITER_API_KEY=
# SOL/USD chain: DexScreener (primary) -> Jupiter -> pumpcoins -> CoinGecko
# -> last-known cache. Each source is time-boxed (5s) and fails open. The
# pumpcoins/coingecko URLs have built-in defaults; set only to override.
# PUMPCOINS_SOL_PRICE_URL=https://pumpcoins.net/api/sol-price
# COINGECKO_SOL_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd

# ============ DEXPAPRIKA (optional — NOT wired into the bot yet) ============
# Agent-side data source for pump.fun tokens/pools (near-real-time). The MCP
# server lives in .prime/agent/settings.json; the REST API is keyless and the
# SSE price stream is /sse/prices?method=token_price&chain=solana&address=<mint>.
# These keys are kept here for a future SOL-fallback / pool-sanity tier.
# DEX_PAPRIKA_KEY=api_xxx
# DEX_PAPRIKA_REST_URL=https://api.dexpaprika.com
# DEX_PAPRIKA_STREAMING_URL=https://streaming.dexpaprika.com


# ============ PUMP.FUN FEEDS (new-token detection) ============
# PRIMARY: pumpapi.io — free, no API key. Server pushes all events; bot filters to pump.fun.
PUMPAPI_WSS=wss://stream.pumpapi.io/
# FALLBACK: pumpdev.io WS — used only if the primary feed goes silent/down.
PUMPDEV_WSS=wss://pumpdev.io/ws
PUMPDEV_API_KEY=

# ============ DEXSCREENER (pair liquidity / volume / price) ============
# Default built into config.py; uncomment only if you proxy.
# DEXSCREENER_API=https://api.dexscreener.com

# ============ SOLANA RPC (optional reads) ============
# Not required for the Jupiter /order + /execute path. Free tier from Helius/Alchemy.
SOLANA_RPC_URL=

# ============ TELEGRAM ALERTS / REPORTING ============
# From @BotFather (bot token) and your user/channel id.
BOT_TOKEN=
CHAT_ID=

# ============ BOT CONFIG ============
# Strategy mode — which candidate source drives trading:
#   STRATEGY_MODE=launch   (default) — pump.fun launch sniper: reacts to new
#                                      create events, rug+score+dev-veto funnel,
#                                      entry within ~2s of launch. Replay-validated
#                                      (+$16.38 over 4 days). The primary strategy.
#   STRATEGY_MODE=signal            — debot smart-money signal scanner: reacts to
#                                      tokens smart-money wallets are accumulating,
#                                      across ALL DEXs (pump_swap, pump, meteora,
#                                      raydium, ...). Experimental — the 0.72-1.87x
#                                      pump-band gate + tight exits showed promise
#                                      on replay but needs out-of-sample validation.
STRATEGY_MODE=launch
STARTING_AMOUNT=2
STOP_LOSS=0.82
TAKE_PROFIT=2.0
SLIPPAGE=150
POLL_INTERVAL=8
MAX_SCAN_WINDOW=15
LOSS_PAUSE_TRIGGER=2
LOSS_PAUSE_MINUTES=5
PLAY_FLOOR=1
REINVEST_RATIO=0.60
DRY_RUN=true
AUTO_START=true

# Wallet private key (base58) — REQUIRED for live trading. NEVER use your main wallet.
# Create a dedicated wallet with Phantom or the Solana CLI; fund with USDC + SOL.
PRIVATE_KEY=

# Quote gate tuning (optional)
# QUOTE_RATE_PER_SEC=1.0
# MAX_PRICE_IMPACT_PCT=10.0
# QUOTE_CACHE_TTL_SEC=30.0
# QUOTE_RETRIES=3
# QUOTE_RETRY_DELAY_SEC=0.5
# SLIPPAGE_TIERS=50000:150,10000:300,2000:500,0:1000

# --- hardening v2 ---
# DAILY_LOSS_LIMIT=8         # halt until UTC midnight when daily PnL <= -limit (0=off)
# STATUS_INTERVAL_MIN=15     # periodic /status heartbeat card (0=off)
# MAX_HOLD_MIN=30            # force-exit a position held this long (stuck watchdog)
# LIVE_FEED_EXIT=true        # PumpAPI buy/sell stream for sub-second TP/SL
MIN_SCORE=60               # min score to queue: launch candidates (backtest-validated) + signal candidates

# paper wallet initial balance; position size stays STARTING_AMOUNT
STARTING_BALANCE=20
# dead-token exit: no live trades for this long + no DexScreener pair -> exit
# STALE_EXIT_SEC=60
# STALE_EXIT_GRACE_SEC=15
# drop queued candidates older than this (queue backlog)
# MAX_CANDIDATE_AGE_MIN=5
# entry liquidity floor (USD, on-chain pool; 0=off) + confirmation window
MIN_LIQUIDITY_USD=5000
LIQ_CONFIRM_WINDOW_S=2
# skip the buy when the token already traded at > MAX_ENTRY_MULT x the launch
# price — don't chase the already-pumped fill (replay-validated; 0=off)
MAX_ENTRY_MULT=5.0

# --- helius dev-reputation veto (read-only, fail-open) ---
# HELIUS_API_KEY=            # defaults to the api-key embedded in SOLANA_RPC_URL
DEV_REP_ENABLED=true
DEV_REP_MAX_CREATES_24H=3   # veto devs with >= N pump.fun creates in 24h
DEV_REP_MIN_AGE_HOURS=0     # veto wallets younger than this (0=off)
DEV_REP_CACHE_TTL_MIN=10
DEV_REP_TIMEOUT_S=2.5

# --- debot smart-money signal scanner (STRATEGY_MODE=signal) ---
# Polls debot /channel/list for signal events and feeds the same queue as the
# launch scanner. Replay research found ONE robust winner feature: a *moderate
# pre-signal pump* — max_price_gain (highest price / first-signal price) in the
# 0.72-1.87x band won ~30% vs 8-10% for flat or already-2x tokens. The gain band
# below is the anti-chase gate; everything else is loose hygiene
# (liquidity/holders/top10). Only used when STRATEGY_MODE=signal.
# SIGNAL_POLL_SEC=20            # poll interval
# SIGNAL_MAX_AGE_SEC=300        # ignore signals older than this at poll time
# SIGNAL_MIN_GAIN=0.72          # reject tokens that haven't moved yet
# SIGNAL_MAX_GAIN=1.87          # reject tokens already pumped > this (chasing)
# SIGNAL_MIN_WALLETS=1          # smart wallets in the signal event
# SIGNAL_MIN_LIQUIDITY_USD=5000
# SIGNAL_MAX_LIQUIDITY_USD=500000
# SIGNAL_MIN_HOLDERS=30
# SIGNAL_MAX_TOP10=0.35         # max top-10 holder concentration (rug proxy)
# SIGNAL_MAX_MCAP_USD=500000
# SIGNAL_MIN_VOL24_USD=1000
# SIGNAL_MIN_SIGNALS=1
# SIGNAL_REJECT_TIERS=          # comma-separated token_level tiers to reject

# ============ JUPITER (execution + price fallback) ============
# Base: https://api.jup.ag  (/price/v3 + /swap/v2). FREE tier = 1 RPS.
# Get a key (free) at https://developers.jup.ag/portal
JUPITER_API_KEY=

# ============ PUMP.FUN FEEDS (new-token detection) ============
# PRIMARY: pumpapi.io — free, no API key. Server pushes all events; bot filters to pump.fun.
PUMPAPI_WSS=wss://stream.pumpapi.io/
# FALLBACK: pumpdev.io WS — used only if the primary feed goes silent/down.
PUMPDEV_WSS=wss://pumpdev.io/ws
PUMPDEV_API_KEY=

# ============ DEXSCREENER (pair liquidity / volume / price) ============
# Default built into config.py; uncomment only if you proxy.
# DEXSCREENER_API=https://api.dexscreener.com

# ============ SOLANA RPC (optional reads) ============
# Not required for the Jupiter /order + /execute path. Free tier from Helius/Alchemy.
SOLANA_RPC_URL=

# ============ TELEGRAM ALERTS / REPORTING ============
# From @BotFather (bot token) and your user/channel id.
BOT_TOKEN=
CHAT_ID=

# ============ BOT CONFIG ============
STARTING_AMOUNT=2
STOP_LOSS=0.82
TAKE_PROFIT=2.0
SLIPPAGE=150
POLL_INTERVAL=8
MAX_SCAN_WINDOW=15
LOSS_PAUSE_TRIGGER=2
LOSS_PAUSE_MINUTES=5
PLAY_FLOOR=1
REINVEST_RATIO=0.60
DRY_RUN=true
AUTO_START=true

# Wallet private key (base58) — REQUIRED for live trading. NEVER use your main wallet.
# Create a dedicated wallet with Phantom or the Solana CLI; fund with USDC + SOL.
PRIVATE_KEY=

# Quote gate tuning (optional)
# QUOTE_RATE_PER_SEC=1.0
# MAX_PRICE_IMPACT_PCT=10.0
# QUOTE_CACHE_TTL_SEC=30.0
# QUOTE_RETRIES=3
# QUOTE_RETRY_DELAY_SEC=0.5
# SLIPPAGE_TIERS=50000:150,10000:300,2000:500,0:1000
